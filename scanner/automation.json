{
  "_doc": "Surveys the fork against the classification registry, files a labelled issue per actionable finding, and proposes new classifications as a PR. Detection is a judgement call, so it is a Devin session rather than a static scanner. Keys prefixed with _ are stripped before POST.",
  "name": "Superset — nightly scan",
  "enabled": true,
  "run_as": {"type": "organization"},
  "triggers": [
    {
      "event_type": "schedule:recurring",
      "conditions": {
        "any": [
          {
            "all": [
              {
                "field": "rrule",
                "operator": "recurrence",
                "value": "DTSTART;TZID=America/Los_Angeles:19700101T020000\nRRULE:FREQ=DAILY"
              }
            ]
          }
        ]
      }
    },
    {
      "_doc": "The manual entry point. There is no run-now REST call, and the inbound-webhook trigger's secret is issued once in the UI and returned as null by the API, so it cannot be set up programmatically. Labelling an issue can be, with the same GitHub token the rest of the system already needs — so `make scan` opens a throwaway issue and labels it, and the scan closes it on arrival.",
      "event_type": "github:issues",
      "conditions": {
        "any": [
          {
            "all": [
              {"field": "repository.full_name", "operator": "eq", "value": "{{REPO}}"},
              {"field": "action", "operator": "eq", "value": "labeled"},
              {"field": "label.name", "operator": "eq", "value": "devin:scan"}
            ]
          }
        ]
      }
    }
  ],
  "actions": [
    {
      "type": "start_session",
      "prompt": "{{SCAN_PROMPT}}",
      "session": {
        "tags": ["superset-remediation", "role:scan"],
        "bypass_approval": true
      }
    }
  ],
  "limits": {
    "max_acu_limit": 30,
    "invocations": {"max_per_window": 12, "window_seconds": 86400}
  },
  "concurrency": {"max_concurrent_runs": 1, "max_queue_depth": 0},
  "session_settings": {
    "devin_mode": "normal",
    "net_policy": {
      "allow": [
        {"hostname": "git-manager.devin.ai"},
        {"hostname": "api.github.com"},
        {"hostname": "github.com"},
        {"hostname": "codeload.github.com"},
        {"hostname": "registry.npmjs.org"},
        {"hostname": "pypi.org"},
        {"hostname": "files.pythonhosted.org"},
        {"hostname": "api.osv.dev"}
      ]
    }
  },
  "metadata": {"project": "superset-remediation", "role": "scanner"}
}
