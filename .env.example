# Copy to .env. Never commit the filled-in version.

# The fork this system watches and fixes, as owner/name. `make bootstrap`
# creates it by forking apache/superset if it does not exist yet.
REPO=

# Service-user key. The v3 org endpoints (automations, playbooks, sessions) are
# service-user RBAC: a personal key is rejected there. The Admin role covers it.
# https://app.devin.ai/settings/org-service-users
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Needs: repo (to fork and to seed the classification registry), issues
# (read/write), pull_requests (read/write, to close rejected work). Not merge.
GITHUB_TOKEN=

POLL_INTERVAL_SECONDS=30

# No ACU settings: cost is reported only where the consumption API measures
# it, which requires an Enterprise account. See README, "Cost accounting".
