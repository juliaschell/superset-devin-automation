{
  "_doc": "One door: an issue is labelled devin:ready, by the scanner or by a human. Reworking a PR after review is deliberately not here — Devin's own PR comment monitoring already answers reviews on the PRs these sessions open, and a second trigger only races it. The tracker measures how often that happens instead. Keys prefixed with _ are stripped before POST.",
  "name": "Superset — remediate",
  "enabled": true,
  "run_as": {"type": "organization"},
  "triggers": [
    {
      "event_type": "github:issues",
      "conditions": {
        "any": [
          {
            "all": [
              {"field": "repository.full_name", "operator": "eq", "value": "{{REPO}}"},
              {"field": "action", "operator": "eq", "value": "labeled"},
              {"field": "label.name", "operator": "eq", "value": "devin:ready"}
            ]
          }
        ]
      },
      "replies": [{"type": "post_response"}]
    }
  ],
  "actions": [
    {
      "type": "start_session",
      "prompt": "{{REMEDIATE_PROMPT}}",
      "session": {
        "tags": ["superset-remediation", "role:remediate", "repo:{{REPO}}"],
        "bypass_approval": true
      }
    }
  ],
  "limits": {
    "max_acu_limit": 20,
    "invocations": {"max_per_window": 50, "window_seconds": 86400}
  },
  "concurrency": {"max_concurrent_runs": 2, "max_queue_depth": 10},
  "session_settings": {
    "devin_mode": "normal",
    "net_policy": {
      "allow": [
        {"hostname": "git-manager.devin.ai"},
        {"hostname": "api.github.com"},
        {"hostname": "github.com"},
        {"hostname": "codeload.github.com"},
        {"hostname": "registry.npmjs.org"},
        {"hostname": "pypi.org"},
        {"hostname": "files.pythonhosted.org"}
      ]
    }
  },
  "metadata": {"project": "superset-remediation", "role": "remediator"}
}
