# Copy to .env. Never commit the filled-in version.

# replay = offline, reads demo/recorded_run.json, no credentials needed.
# live   = polls Devin and GitHub.
MODE=replay

REPO=juliaschell/superset

# Service-user key. The v3 org endpoints (automations) are service-user RBAC:
# a personal key is rejected there. Needs ViewOrgAutomations +
# ManageOrgAutomations, and ViewOrgSessions for the reconciler.
DEVIN_API_KEY=
DEVIN_ORG_ID=

# Needs: issues (read/write, for cleanup), pull_requests (read/write, to close
# rejected work). Not merge.
GITHUB_TOKEN=

POLL_INTERVAL_SECONDS=30

# ACUs are read off the org usage page and reported, not measured — the API
# does not expose per-session ACUs for this org.
BUILD_ACUS=0
RUN_ACUS=0
